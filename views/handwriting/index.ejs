<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Handwriting Video Generator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&family=Dancing+Script:wght@400;700&family=Pacifico&family=Satisfy&family=Kaushan+Script&family=Sacramento&family=Great+Vibes&family=Pinyon+Script&family=Meddon&family=Rock+Salt&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/handwriting/style.css">
</head>
<body>
<div id="app">
  <!-- LEFT PANEL: Controls -->
  <aside id="controls-panel">
    <div class="panel-header">
      <h1>✍️ Handwriting<br><span>Video Generator</span></h1>
    </div>

    <!-- TEXT INPUT -->
    <section class="ctrl-section">
      <label class="section-title">TEXTO</label>
      <textarea id="input-text" rows="3" placeholder="Escribe tu texto aquí...">Hello World</textarea>
    </section>

    <!-- FONT -->
    <section class="ctrl-section">
      <label class="section-title">TIPOGRAFÍA</label>
      <div class="font-grid" id="font-picker">
        <div class="font-card active" data-font="Caveat">
          <span style="font-family:'Caveat'">Caveat</span>
        </div>
        <div class="font-card" data-font="Dancing Script">
          <span style="font-family:'Dancing Script'">Dancing Script</span>
        </div>
        <div class="font-card" data-font="Pacifico">
          <span style="font-family:'Pacifico'">Pacifico</span>
        </div>
        <div class="font-card" data-font="Satisfy">
          <span style="font-family:'Satisfy'">Satisfy</span>
        </div>
        <div class="font-card" data-font="Kaushan Script">
          <span style="font-family:'Kaushan Script'">Kaushan</span>
        </div>
        <div class="font-card" data-font="Sacramento">
          <span style="font-family:'Sacramento'">Sacramento</span>
        </div>
        <div class="font-card" data-font="Great Vibes">
          <span style="font-family:'Great Vibes'">Great Vibes</span>
        </div>
        <div class="font-card" data-font="Pinyon Script">
          <span style="font-family:'Pinyon Script'">Pinyon</span>
        </div>
        <div class="font-card" data-font="Rock Salt">
          <span style="font-family:'Rock Salt'">Rock Salt</span>
        </div>
        <div class="font-card" data-font="Meddon">
          <span style="font-family:'Meddon'">Meddon</span>
        </div>
      </div>
    </section>

    <!-- COLOR MODE -->
    <section class="ctrl-section">
      <label class="section-title">COLOR</label>
      <div class="toggle-row">
        <button class="mode-btn active" data-mode="solid">Sólido</button>
        <button class="mode-btn" data-mode="gradient">Degradé</button>
        <button class="mode-btn" data-mode="rainbow">Arcoíris</button>
        <button class="mode-btn" data-mode="neon">Neón</button>
      </div>
      <div id="color-solid" class="color-group">
        <input type="color" id="color1" value="#ffffff">
        <label>Color principal</label>
      </div>
      <div id="color-gradient" class="color-group hidden">
        <div class="color-row">
          <input type="color" id="grad1" value="#ff6b6b">
          <span>→</span>
          <input type="color" id="grad2" value="#4ecdc4">
        </div>
        <select id="grad-dir">
          <option value="horizontal">Horizontal</option>
          <option value="vertical">Vertical</option>
          <option value="diagonal">Diagonal</option>
          <option value="radial">Radial</option>
        </select>
      </div>
      <div id="color-neon" class="color-group hidden">
        <input type="color" id="neon-color" value="#00ff88">
        <label>Color neón</label>
        <div class="slider-row">
          <label>Brillo glow</label>
          <input type="range" id="glow-size" min="2" max="40" value="15">
          <span id="glow-val">15</span>
        </div>
      </div>
    </section>

    <!-- ANIMATION -->
    <section class="ctrl-section">
      <label class="section-title">ANIMACIÓN</label>
      <div class="toggle-row">
        <button class="anim-btn active" data-anim="write">Escribir</button>
        <button class="anim-btn" data-anim="bounce">Bounce</button>
        <button class="anim-btn" data-anim="shake">Shake</button>
        <button class="anim-btn" data-anim="wave">Wave</button>
        <button class="anim-btn" data-anim="glitch">Glitch</button>
        <button class="anim-btn" data-anim="ink">Ink Drop</button>
      </div>
    </section>

    <!-- STROKE -->
    <section class="ctrl-section">
      <label class="section-title">TRAZO</label>
      <div class="slider-row">
        <label>Grosor</label>
        <input type="range" id="stroke-width" min="1" max="20" value="4">
        <span id="sw-val">4</span>
      </div>
      <div class="slider-row">
        <label>Irregularidad</label>
        <input type="range" id="jitter" min="0" max="10" value="2">
        <span id="jit-val">2</span>
      </div>
      <div class="slider-row">
        <label>Presión variación</label>
        <input type="range" id="pressure" min="0" max="100" value="40">
        <span id="pres-val">40%</span>
      </div>
      <div class="toggle-check">
        <input type="checkbox" id="ink-bleed" checked>
        <label for="ink-bleed">Efecto tinta (ink bleed)</label>
      </div>
    </section>

    <!-- TIMING -->
    <section class="ctrl-section">
      <label class="section-title">VELOCIDAD &amp; TIEMPO</label>
      <div class="slider-row">
        <label>Velocidad escritura</label>
        <input type="range" id="write-speed" min="1" max="20" value="8">
        <span id="ws-val">8</span>
      </div>
      <div class="slider-row">
        <label>Hold final (seg)</label>
        <input type="range" id="hold-time" min="0" max="5" step="0.5" value="1">
        <span id="ht-val">1s</span>
      </div>
      <div class="slider-row">
        <label>Delay entre letras</label>
        <input type="range" id="letter-delay" min="0" max="500" step="10" value="50">
        <span id="ld-val">50ms</span>
      </div>
    </section>

    <!-- SIZE & POSITION -->
    <section class="ctrl-section">
      <label class="section-title">TAMAÑO &amp; POSICIÓN</label>
      <div class="slider-row">
        <label>Tamaño fuente</label>
        <input type="range" id="font-size" min="20" max="300" value="100">
        <span id="fs-val">100px</span>
      </div>
      <div class="slider-row">
        <label>Posición X</label>
        <input type="range" id="pos-x" min="0" max="100" value="50">
        <span id="px-val">50%</span>
      </div>
      <div class="slider-row">
        <label>Posición Y</label>
        <input type="range" id="pos-y" min="0" max="100" value="50">
        <span id="py-val">50%</span>
      </div>
      <div class="slider-row">
        <label>Rotación</label>
        <input type="range" id="rotation" min="-45" max="45" value="0">
        <span id="rot-val">0°</span>
      </div>
    </section>

    <!-- EXPORT -->
    <section class="ctrl-section">
      <label class="section-title">EXPORTAR</label>
      <div class="export-grid">
        <div>
          <label>Resolución</label>
          <select id="resolution">
            <option value="720">720p HD</option>
            <option value="1080" selected>1080p Full HD</option>
            <option value="1440">1440p 2K</option>
            <option value="2160">4K UHD</option>
          </select>
        </div>
        <div>
          <label>FPS</label>
          <select id="fps">
            <option value="24">24 fps</option>
            <option value="30" selected>30 fps</option>
            <option value="60">60 fps</option>
          </select>
        </div>
        <div>
          <label>Formato</label>
          <select id="format">
            <option value="webm">WebM (transparente)</option>
            <option value="gif">GIF animado</option>
          </select>
        </div>
        <div>
          <label>Calidad</label>
          <select id="quality">
            <option value="0.6">Baja</option>
            <option value="0.8" selected>Media</option>
            <option value="0.95">Alta</option>
            <option value="1.0">Máxima</option>
          </select>
        </div>
      </div>
    </section>

    <div class="action-buttons">
      <button id="btn-preview" class="btn-primary">▶ Preview</button>
      <button id="btn-export" class="btn-export">⬇ Exportar Video</button>
    </div>
    <div id="export-progress" class="hidden">
      <div class="progress-bar"><div id="progress-fill"></div></div>
      <span id="progress-text">Renderizando...</span>
    </div>
  </aside>

  <!-- RIGHT PANEL: Canvas Preview -->
  <main id="preview-area">
    <div id="canvas-wrapper">
      <div id="checkerboard"></div>
      <canvas id="preview-canvas"></canvas>
    </div>
    <div id="canvas-info">
      <span id="info-res">1920×1080</span>
      <span id="info-fps">30 fps</span>
      <span id="info-dur">--s</span>
      <span id="info-status">Listo</span>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/opentype.js@1.3.4/dist/opentype.min.js"></script>
<script src="/handwriting/engine.js"></script>
</body>
</html>
